    "{numbers}": "123",
    "{shift}": "  ⇧  ",
    "{tab}": "tab",
  },
  "inputName": "kbInput",
  "layout": {
    "layout": "English",
  },
  "layoutName": "shift",
  "mergeDisplay": true,
