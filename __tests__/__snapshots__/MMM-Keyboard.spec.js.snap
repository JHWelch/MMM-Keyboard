  "onKeyPress": [Function],
}
`;

exports[`getDom can generate a dom for debug 1`] = `
<div
  class="keyboardWrapper"
>
  <div
    class="kbButton fas fa-keyboard"
  />
  <div
    class="kbContainer"
  >
    <div
      id="inputDiv"
      style="display: none;"
    >
      <input
        id="kbInput"
        type="text"
      />
      <button
        class="sendButton"
        id="sendButton"
        name="sendButton"
      />
      <button
        class="hideButton"
        name="hideButton"
      />
    </div>
    <div
      class="simple-keyboard"
    />
  </div>
</div>
`;

