    "{backspace}": "  ⇦  ",
    "{controlleft}": "ctrl",
    "{controlright}": "ctrl",
    "{ent}": "return",
    "{escape}": "esc",
    "{lock}": "  ⇮  ",
    "{metaleft}": "cmd",
